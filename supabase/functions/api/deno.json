{
  "imports": {
    "postgres": "npm:postgres@3.4.5",
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "gen-schema": "deno run --allow-read --allow-write --allow-env scripts/gen_schema.ts",
    "serve": "deno run --allow-net --allow-env --allow-read index.ts",
    "check": "deno check index.ts tests/*.ts",
    "lint": "deno lint",
    "test": "deno test --allow-net --allow-env --allow-read",
    "test:unit": "deno test --allow-net --allow-env --allow-read tests/unit_*.test.ts",
    "test:integration": "deno test --allow-net --allow-env --allow-read tests/integration.test.ts"
  },
  "lint": {
    "rules": { "exclude": ["no-explicit-any"] }
  },
  "fmt": { "lineWidth": 120, "exclude": ["README.md", "lib/validate_payload.generated.js"] }
}
