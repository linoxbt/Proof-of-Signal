{
  "name": "proof-of-signal-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --port 3100",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/geo-layers": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@protomaps/basemaps": "^5.7.2",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "h3-js": "^4.5.0",
    "lucide-react": "^1.72.0",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pmtiles": "^4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
